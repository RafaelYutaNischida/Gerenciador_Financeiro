generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  INCOME  @map("income")
  EXPENSE @map("expense")

  @@map("movement_type")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(100)
  email        String     @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  movements    Movement[]

  @@map("users")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique(map: "categories_code_key") @db.VarChar(32)
  name        String         @db.VarChar(60)
  type        MovementType
  movements   Movement[]

  @@unique([name, type], map: "categories_name_type_key")
  @@map("categories")
}

model Movement {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  categoryId   String       @map("category_id") @db.Uuid
  description  String       @db.VarChar(120)
  amount       Decimal      @db.Decimal(12, 2)
  movementDate DateTime     @map("movement_date") @db.Date
  notes        String?      @db.VarChar(500)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, movementDate(sort: Desc)], map: "movements_user_date_idx")
  @@index([categoryId], map: "movements_category_id_idx")
  @@map("movements")
}
